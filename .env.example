# Copia este archivo como .env y reemplaza los valores de ejemplo.
# Usa una clave aleatoria de al menos 32 caracteres para APP_JWT_SECRET.
APP_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
MAIL_SERVICE_API_KEY=replace-with-a-shared-random-key
LECTOR_API_KEY=replace-with-another-shared-random-key

# Opcional: habilita el inicio de sesiÃ³n con Google cuando uses estas credenciales.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_OAUTH_GOOGLE_ENABLED=false

# Opcional: configura SMTP si deseas enviar correos.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Cookies locales sobre HTTP deben permanecer en false.
APP_COOKIE_SECURE=false

# Mongo del contenedor queda disponible para herramientas locales en este puerto.
MONGO_PORT=27018

# Opcional: para usar Atlas, configura estas variables con las URI deseadas.
# Sin ellas, Compose utiliza su MongoDB local y aislado.
DOCKER_ACCESO_MONGODB_URI=
DOCKER_TRANSPORTE_MONGODB_URI=
DOCKER_BILLETERA_MONGODB_URI=
DOCKER_RECARGAS_MONGODB_URI=
DOCKER_LECTOR_MONGODB_URI=
